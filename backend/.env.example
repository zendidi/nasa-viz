APP_ENV=dev
APP_SECRET=changeme

###> symfony/routing ###
# Base URL for generating URLs outside an HTTP request (console commands).
# Referenced by config/packages/routing.yaml. Leaving it out does not fail
# lint:container -- env vars resolve lazily -- but any real boot does:
# `cache:warmup` dies with `Environment variable not found: "DEFAULT_URI"`.
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nasa-viz ###
# DEMO_KEY works out of the box but is rate-limited (30 req/hour, 50 req/day).
# Get a free key at https://api.nasa.gov and replace it here for real usage.
NASA_API_KEY=DEMO_KEY
NASA_BASE_URL=https://api.nasa.gov
SCIENCE_NASA_BASE_URL=https://science.nasa.gov
ISS_POSITION_BASE_URL=https://api.wheretheiss.at/v1
# JPL Horizons (real NEO positions) — keyless, outside the api.nasa.gov quota.
HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api
# NEO sources compared with NASA NeoWs (docs/neo-jpl-ssodnet.md) — keyless, outside the api.nasa.gov quota.
JPL_SSD_API_BASE_URL=https://ssd-api.jpl.nasa.gov
ESA_NEOCC_BASE_URL=https://neo.ssa.esa.int/PSDB-portlet
SSODNET_BASE_URL=https://ssp.imcce.fr/webservices/ssodnet/api
###< nasa-viz ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
